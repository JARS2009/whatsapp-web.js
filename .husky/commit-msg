# Normalize commit type to lowercase (awk instead of GNU-only `sed \L`,
# which macOS sed turns into a literal "L")
awk 'NR == 1 && match($0, /^[A-Za-z]+/) { $0 = tolower(substr($0, 1, RLENGTH)) substr($0, RLENGTH + 1) } { print }' "$1" > "$1.tmp" && mv "$1.tmp" "$1"

npx --no-install commitlint --edit "$1"
